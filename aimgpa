import sys

tokens = sys.stdin.read().split()

def main():
    if len(tokens) != 4:
        sys.stderr.write(
                "入力エラー : 4つの数値を入力する必要があります(現在のGPA、修得済単位数、今学期履修中単位数、目標GPA\n)"
                )
        sys.exit(1)

    try:
        current_gpa = float(tokens[0])
        earned_credits = float(tokens[1])
        current_credits = float(tokens[2])
        target_gpa = float(tokens[3])
    except ValueError:
        sys.stderr.write("入力エラー : すべて数値で入力する必要があります\n")
        sys.exit(1)

    if earned_credits < 0 or current_credits <= 0:
        sys.stderr.write("入力エラー : 単位数が不正です\n")
        sys.exit(1)

    if not (0.0 <= current_gpa <= 4.0 and 0.0 <= target_gpa <= 4.0):
        sys.stderr.write("入力エラー: GPAは0.0から4.0の範囲で指定する必要があります\n")
        sys.exit(1)

    total_credits = earned_credits + current_credits
    required_gpa = (target_gpa * total_credits - current_gpa * earned_credits) / current_credits

    print(f"{required_gpa:.2f}")

if __name__ == "__main__":
    main()

